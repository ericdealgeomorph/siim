# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.pytest_cache/

# Numba cache
*.nbc
*.nbi

# Jupyter — notebooks are paired to py:percent (see jupytext.toml); the .py is
# the tracked source of truth, the .ipynb is local-only and regenerated by Jupyter.
.ipynb_checkpoints/
*.ipynb

# Sphinx build output
docs/_build/

# Virtual environment
.venv/
venv/
env/
uv.lock

# macOS
.DS_Store

# Model outputs (large, local)
model_outputs/

# Escarpment init topos (local)
escarpment_code/init_topos/*

# Cycle-dynamics research scratch (kept local only)
notebooks/cycle_dynamics/

# Stability-analysis research scratch (kept local only)
notebooks/stablity_analysis/

# Large outputs
*.gif
*.mp4
*.pkl

# Claude
.claude/

# Project memory: scratch notes are ephemeral (keep dir, ignore contents)
_memory/scratch/*
!_memory/scratch/.gitkeep

# LaTeX build artifacts (latexmk writes aux into .build/; see ~/.latexmkrc)
.build/
*.synctex.gz
*.aux
*.bbl
*.blg
*.nlo
*.nls
*.nlg
*.ilg
*.fls
*.fdb_latexmk
*.toc

# VS Code workspace settings (machine-specific: jupytext auto-sync hook)
.vscode/

# Generated model output (figures/movies; written under CWD by _output.output_path)
notebooks/model_outputs/

# ruff lint cache
.ruff_cache/

# Standalone bundle copied for Thea (a full copy of siim + the escarpment
# notebooks, for sending to her); local-only, never tracked.
/for_thea/

# coverage artifacts
.coverage

# Locally-frozen S0 reference battery (platform-bound bit-for-bit refs; the
# committed battery in siim/tests/data/reference/ is the CI/linux one)
siim/tests/data/reference_local/
